# 값만 입력하세요. 이 파일의 복사본 .env는 Git에 올리지 않습니다.
NEIS_API_KEY=
# 자료·DB·분석·보고서 전용 경로. /volume1 또는 named volume으로 바꾸지 마세요.
NAS_DATA_DIR=/volume2/moa/data
# NAS 설치 스크립트가 실제 SSH 사용자 UID/GID로 채웁니다.
MOA_UID=10001
MOA_GID=10001
# 매일 한국시간. 첫 기동에는 한 번 즉시 실행합니다.
DAILY_AT=04:00
RUN_ON_START=true
SEOUL_DAILY_TARGET=10
OTHER_DAILY_TARGET=5
MAX_NOTICES_PER_SCHOOL=1
MAX_SCHOOLS_PER_REGION=50
MAX_POSTS_PER_SCHOOL=12
LOOKBACK_DAYS=365
REQUEST_DELAY_SECONDS=2
MAX_HTTP_REQUESTS=5000
MIN_FREE_MB=1024
# 재외한국학교교육청(V10)은 17개 시도교육청 밖이라 기본 목표(10+16*5=90)에서 제외합니다.
# 해외 한국학교도 수집하려면 비워 두세요. 쉼표로 여러 코드를 지정할 수 있습니다.
EXCLUDE_OFFICES=V10
# 지역별 실패 기록 상한. 늘리면 보고서에 더 많은 실패 학교/사유가 남습니다.
MAX_ERRORS_PER_REGION=500
# 하루 수집이 일시 오류(network/API)로 끝났을 때 다시 시도하기까지 기다리는 분.
# 완료/부분완료로 끝난 날은 이 값과 무관하게 그날 다시 실행하지 않습니다.
RETRY_MINUTES=60
# 차단/오류 때만 바꾸세요. 기본값은 봇임을 밝히는 표준 형식입니다.
# MOA_USER_AGENT=Mozilla/5.0 (compatible; MoaNoticeBot/0.1; +https://github.com/h19h29-design/moa)
